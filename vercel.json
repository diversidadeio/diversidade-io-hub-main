{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/verificar-cnpjs-lote",
      "destination": "/api/verificar-cnpj"
    },
    {
      "source": "/api/ping",
      "destination": "/api/presence?action=ping"
    },
    {
      "source": "/api/usuarios-online",
      "destination": "/api/presence?action=online"
    },
    {
      "source": "/api/ler-logs",
      "destination": "/api/logs?action=geral"
    },
    {
      "source": "/api/ler-logs-empresa",
      "destination": "/api/logs?action=empresa"
    },
    {
      "source": "/api/ler-logs-metricas",
      "destination": "/api/logs?action=metricas"
    },
    {
      "source": "/api/relatorio-empresa",
      "destination": "/api/logs?action=relatorio"
    },
    {
      "source": "/api/maiores-melhores-acesso",
      "destination": "/api/enviar-email-aprovacao?action=mm-acesso"
    },
    {
      "source": "/api/maiores-melhores-foto",
      "destination": "/api/enviar-email-aprovacao?action=mm-foto"
    },
    {
      "source": "/api/maiores-melhores-inscricao",
      "destination": "/api/enviar-email-aprovacao?action=mm-inscricao"
    },
    {
      "source": "/api/maiores-melhores-negocio",
      "destination": "/api/enviar-email-aprovacao?action=mm-negocio"
    },
    {
      "source": "/api/maiores-melhores-votacao",
      "destination": "/api/enviar-email-aprovacao?action=mm-votacao"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
